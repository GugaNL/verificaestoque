# ===== Servidor =====
PORT=3000
LOG_LEVEL=info
# URL pública deste serviço (usada no link de descadastro do e-mail)
PUBLIC_BASE_URL=https://verificaestoque.codexlabdigital.com.br

# ===== Banco (Postgres) =====
DATABASE_URL=postgres://verificaestoque:senha@localhost:5432/verificaestoque

# ===== Loja (Oracle Commerce Cloud) =====
# URL da loja (Store API). Usada para validar o token do cliente, buscar dados do produto e consultar estoque.
STORE_BASE_URL=https://www.nortesulreal.com.br
# Sites aceitos nas inscrições (separados por vírgula)
ALLOWED_SITE_IDS=norteSulRealDec
# Catálogo do site (necessário para campos traduzíveis do produto)
CATALOG_ID=nortesul1
# Idioma usado nas consultas de produto
ASSET_LANGUAGE=pt_BR
# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=https://www.nortesulreal.com.br

# ===== Job de estoque =====
# Expressão cron (padrão: a cada 15 minutos)
CHECK_CRON=*/15 * * * *
# Quantos SKUs consultar por requisição de estoque
INVENTORY_BATCH_SIZE=50
# Quantidade mínima em estoque para considerar "voltou"
MIN_STOCK_LEVEL=1
# Tentativas de envio antes de marcar como erro
MAX_SEND_ATTEMPTS=3
# Validade da inscrição em dias
SUBSCRIPTION_TTL_DAYS=90

# ===== E-mail (SMTP) =====
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@nortesulreal.com.br
SMTP_PASS=
MAIL_FROM="Norte Sul <no-reply@nortesulreal.com.br>"
MAIL_SUBJECT=Boa notícia: o produto que você queria voltou ao estoque!
BRAND_NAME=Norte Sul Real

# ===== Admin =====
# Chave para as rotas /v1/admin/* (header x-admin-key). Deixe vazio para desativar as rotas admin.
ADMIN_API_KEY=
